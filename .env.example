# Copy to .env and fill in. Never commit .env or API keys.
# HTTP Basic Auth username is fixed to "demo"; required in production.
DEMO_PASSWORD=

# Model protocol: openai-completions / openai-responses / anthropic-messages
# The local no-key demo is NOT configured here; use `make dev-faux` instead.
LLM_API=openai-completions
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CONTEXT_WINDOW=128000
LLM_MAX_TOKENS=8192

HOST_PORT=3300

# Optional notifications (generic JSON or Feishu text bot)
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_KIND=generic
NOTIFY_MODE=errors

# Production default disables the simulated crash endpoint.
ENABLE_CRASH_DEMO=0

# Optional read-only Obsidian vault search.
OBSIDIAN_ROOT=
OBSIDIAN_ALLOW=

# Go runtime
# PORT=3000
# DATA_DIR=./data
# GO_ENV=production

# HTTP serving mode: http, https, or both. Dev defaults to https.
HTTP_MODE=http
HTTPS_PORT=3443
TLS_CERT_FILE=certs/localhost.pem
TLS_KEY_FILE=certs/localhost-key.pem
