{
  "name": "pi-durable-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "web:install": "pnpm --dir web install --frozen-lockfile",
    "web:dev": "pnpm --dir web dev",
    "web:typecheck": "pnpm --dir web typecheck",
    "web:check": "pnpm --dir web check",
    "web:format": "pnpm --dir web format",
    "web:build": "pnpm --dir web build",
    "dev": "node scripts/dev.mjs",
    "dev:faux": "FAUX_PORT=18789 go run ./cmd/faux-llm",
    "dev:demo": "node scripts/dev.mjs --demo",
    "build": "pnpm web:install && pnpm web:build && mkdir -p dist && CGO_ENABLED=0 go build -trimpath -o dist/pida ./cmd/pida",
    "test": "go test ./...",
    "check": "pnpm test && CGO_ENABLED=0 go build ./... && pnpm web:typecheck && pnpm web:check && pnpm web:build",
    "format": "gofmt -w . && pnpm web:format",
    "docker": "docker compose build",
    "dev:install": "go install github.com/air-verse/air@v1.67.4"
  }
}
